{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", "group:allNonMajor", "schedule:weekly"],
	"labels": ["dependencies"],
	"rangeStrategy": "bump",
	"automerge": true,
	"automergeType": "pr",
	"platformAutomerge": false,
	"lockFileMaintenance": {
		"enabled": true,
		"automerge": true,
		"extends": ["schedule:weekly"]
	}
}
