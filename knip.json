{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": [],
			"project": []
		},
		"packages/prototypey": {
			"entry": ["**/*.test.ts", "**/*.bench.ts"],
			"project": ["**/*.ts"]
		},
		"packages/site": {
			"entry": ["tests/**/*.test.{ts,tsx}"],
			"project": ["src/**/*.{ts,tsx,css}"]
		}
	},
	"ignoreExportsUsedInFile": true
}
